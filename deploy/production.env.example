# Copy to .env for Docker Compose; edit it on the server and keep it private.
DOMAIN=coach.example.com
DEEPSEEK_API_KEY=
REGISTRATION_MODE=open
DAILY_MODEL_LIMIT=30
GLOBAL_DAILY_MODEL_LIMIT=1000
MODEL_CONCURRENCY=10
STORE_CACHE_LIMIT=64
# For the systemd alternative, also set:
# PUBLIC_ORIGIN=https://coach.example.com
# TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
