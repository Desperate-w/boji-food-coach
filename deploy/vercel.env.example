# Fill these in Vercel server-side Environment Variables; never put them in frontend code.
DATABASE_URL=
DEEPSEEK_API_KEY=
# Connect a PRIVATE Vercel Blob store. The platform supplies BLOB_STORE_ID/OIDC
# or BLOB_READ_WRITE_TOKEN. A public store is rejected by the application.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
REGISTRATION_MODE=open
DAILY_MODEL_LIMIT=30
GLOBAL_DAILY_MODEL_LIMIT=1000
MODEL_CONCURRENCY=10
DB_POOL_MAX=5
# Optional custom domain, no trailing slash. Otherwise Vercel uses the request's HTTPS host.
# PUBLIC_ORIGIN=https://your-domain.example
