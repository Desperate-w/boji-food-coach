[Unit]
Description=Boji food coach
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=boji
Group=boji
WorkingDirectory=/opt/boji
EnvironmentFile=/etc/boji.env
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/boji
StateDirectory=boji
StateDirectoryMode=0700
ExecStart=/usr/bin/node /opt/boji/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=150
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/boji

[Install]
WantedBy=multi-user.target
